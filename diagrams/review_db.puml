@startuml review_db
' Generated by scripts/generate_views.mjs; edit fitzza-erd.puml instead.
!pragma layout smetana
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 65
skinparam ranksep 85
skinparam entityBackgroundColor #F8FAFC
skinparam entityBorderColor #475569
hide circle
title Fitzza ERD — review_db
package "review_db" {
  entity "review\n리뷰" as review {
    ' Row 68: 리뷰 아이디
    * review_id : PK, INT, NOT NULL, AUTO_INCREMENT
    ' Row 69: 작성자 아이디 — user_db.users 참조
    * user_id : FK(logical), INT, NOT NULL
    ' Row 70: 상품 아이디 — product_db.product 참조
    * product_id : FK(logical), INT, NOT NULL
    ' Row 71: 주문 항목 아이디 — order_db.order_item 참조, 구매 인증 리뷰용 — 비구매 리뷰 허용 여부 논의 필요
    order_item_id : FK(logical), INT, NULL
    ' Row 72: 평점 — 1~5
    * rating : INT, NOT NULL
    ' Row 73: 리뷰 내용
    * content : TEXT, NOT NULL
    ' Row 74: 첨부 이미지 URL
    image_url : VARCHAR(500), NULL
    ' Row 75: 작성일
    * created_at : DATETIME, NOT NULL, DEFAULT CURRENT_TIMESTAMP
    ' Row 76: 수정일
    updated_at : DATETIME, DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
  }
}
package "외부 참조 (참조 키만 표시)" {
  entity "order_item\n주문 항목\n[order_db]" as order_item #EEF2FF {
    * order_item_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "product\n상품\n[product_db]" as product #EEF2FF {
    * product_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "users\n회원\n[user_db]" as users #EEF2FF {
    * user_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
}
users ||..o{ review : "user_id [logical]"
product ||..o{ review : "product_id [logical]"
order_item |o..o{ review : "order_item_id [logical]"
legend bottom left
  * : NOT NULL explicitly stated in specification
  PK / FK / UNIQUE : source constraints; composite PK spans marked columns
  Solid line : FK stated in specification
  Dotted line : logical, inferred, or conditional reference
  Parent || : required reference; |o : nullable/conditional reference
  Child o{ : zero or more; o| : zero or one (shared primary key or UNIQUE FK)
  Gray entity : unused in source specification
  ENUM / VARCHAR without details and missing types are preserved as specified
endlegend

@enduml
