@startuml review_db
' Generated by scripts/generate_views.mjs; edit fitzza-erd.puml instead.
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 65
skinparam ranksep 85
skinparam entityBackgroundColor #F8FAFC
skinparam entityBorderColor #475569
hide circle
title Fitzza ERD — review_db
package "review_db" {
  entity "review\n리뷰" as review {
    ' Row 68: 리뷰 아이디
    * review_id : PK, INT, NOT NULL, AUTO_INCREMENT
    ' Row 69: 작성자 아이디 — user_db.users 참조
    * user_id : FK(logical), INT, NOT NULL
    ' Row 70: 상품 아이디 — product_db.product 참조
    * product_id : FK(logical), INT, NOT NULL
    ' Row 71: 주문 항목 아이디 — order_db.order_item 참조, 구매 인증 리뷰용 — 비구매 리뷰 허용 여부 논의 필요
    order_item_id : FK(logical), INT, NULL
    ' Row 72: 평점 — 1~5
    * rating : INT, NOT NULL
    ' Row 73: 리뷰 내용
    * content : TEXT, NOT NULL
    ' Row 74: 첨부 이미지 URL
    image_url : VARCHAR(500), NULL
    ' Row 75: 작성일
    * created_at : DATETIME, NOT NULL, DEFAULT CURRENT_TIMESTAMP
    ' Row 76: 수정일
    updated_at : DATETIME, DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
  }
}
package "관계 09 · user_id [logical]" as relation_9 {
  entity "users\n회원\n[user_db]" as relation_9_parent #EEF2FF {
    * user_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "review\n리뷰\n[review_db]" as relation_9_child {
    * review_id : PK, INT, NOT NULL, AUTO_INCREMENT
    * user_id : FK(logical), INT, NOT NULL
  }
relation_9_parent ||.right.o{ relation_9_child
}
package "관계 10 · product_id [logical]" as relation_10 {
  entity "product\n상품\n[product_db]" as relation_10_parent #EEF2FF {
    * product_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "review\n리뷰\n[review_db]" as relation_10_child {
    * review_id : PK, INT, NOT NULL, AUTO_INCREMENT
    * product_id : FK(logical), INT, NOT NULL
  }
relation_10_parent ||.right.o{ relation_10_child
}
package "관계 11 · order_item_id [logical]" as relation_11 {
  entity "order_item\n주문 항목\n[order_db]" as relation_11_parent #EEF2FF {
    * order_item_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "review\n리뷰\n[review_db]" as relation_11_child {
    * review_id : PK, INT, NOT NULL, AUTO_INCREMENT
    order_item_id : FK(logical), INT, NULL
  }
relation_11_parent |o.right.o{ relation_11_child
}
relation_9 -[hidden]right- relation_10
relation_9 -[hidden]down- relation_11
legend bottom left
  * : 명세서에 NOT NULL로 명시된 필수 컬럼
  PK / FK / UNIQUE : 기본 키 / 외래 키 / 유일성 제약
  복합 PK : PK로 표시된 여러 컬럼을 함께 기본 키로 사용
  실선 : 명세서에 명시된 외래 키 관계
  점선 : 논리적·추론된 참조 또는 유형에 따른 조건부 참조
  부모 쪽 || : 필수 참조, |o : NULL 허용 또는 조건부 참조
  자식 쪽 o{ : 0개 이상, o| : 0개 또는 1개 (공유 PK 또는 UNIQUE FK)
  회색 테이블 : 명세서에서 미사용으로 표시된 테이블
  관계 패널 : 관계마다 테이블을 반복 표시하여 연결선 겹침 방지
  연한 보라색 테이블 : 관계의 참조 대상 (기본 키만 표시)
  관계 번호 옆 컬럼명 : 자식 테이블의 참조 컬럼 및 조건
  ENUM 값·VARCHAR 길이·자료형이 미정인 항목은 명세서 그대로 유지
endlegend

@enduml
