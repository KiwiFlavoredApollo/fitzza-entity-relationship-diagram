@startuml fitzza-overview
' Generated by scripts/generate_views.mjs; edit fitzza-erd.puml instead.
!pragma layout smetana
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 65
skinparam ranksep 85
skinparam entityBackgroundColor #F8FAFC
skinparam entityBorderColor #475569
hide circle
title Fitzza ERD — 도메인 개요
top to bottom direction
package "user_db" as user_db {
  entity "users\n회원" as users {
    * user_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "user_body_profile\n사용자 신체정보" as user_body_profile {
    * user_id : PK, FK, INT, NOT NULL
  }
users ||--o| user_body_profile : "user_id"
}
package "user_preferences_db" as user_preferences_db {
  entity "user_measurement_preference\n사용자 선호 실측" as user_measurement_preference {
    * preference_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
}
package "product_db" as product_db {
  entity "brand\n브랜드" as brand {
    * brand_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "product\n상품" as product {
    * product_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "product_option\n상품 옵션" as product_option {
    * option_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "product_measurement\n상품 실측" as product_measurement {
    * option_id : PK, FK, INT, NOT NULL
  }
brand ||--o{ product : "brand_id"
product ||--o{ product_option : "product_id"
product_option ||--o| product_measurement : "option_id"
}
package "order_db" as order_db {
  entity "orders\n주문" as orders {
    * order_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "order_item\n주문 항목" as order_item {
    * order_item_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
orders ||--o{ order_item : "order_id"
}
package "review_db" as review_db {
  entity "review\n리뷰" as review {
    * review_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
}
package "wishlist_db" as wishlist_db {
  entity "wishlist\n찜한 상품" as wishlist {
    * wishlist_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "worldcup_history\n월드컵 우승 이력" as worldcup_history {
    * worldcup_history_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
}
package "cart_db" as cart_db {
  entity "cart\n장바구니" as cart {
    * cart_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
}
package "recommendation_db" as recommendation_db {
  entity "recommendation_request\n추천 요청" as recommendation_request {
    * request_id : PK, VARCHAR, NOT NULL
  }
  entity "recommendation_slot\n추천 슬롯" as recommendation_slot {
    * slot_id : PK, VARCHAR, NOT NULL
  }
  entity "slot_candidate\n슬롯 후보" as slot_candidate {
    * candidate_id : PK, VARCHAR, NOT NULL
  }
  entity "outfit_combo\n코디 조합" as outfit_combo {
    * combo_id : PK, VARCHAR, NOT NULL
  }
  entity "recommendation_message\n추천 대화 히스토리" as recommendation_message {
    * message_id : PK, VARCHAR, NOT NULL
  }
  entity "combo_candidate\n조합-후보 매핑" as combo_candidate {
    * combo_id : PK, FK, VARCHAR, NOT NULL
    * candidate_id : PK, FK, VARCHAR, NOT NULL
  }
recommendation_request ||--o{ recommendation_slot : "request_id"
recommendation_slot ||--o{ slot_candidate : "slot_id"
recommendation_request ||--o{ outfit_combo : "request_id"
recommendation_request ||--o{ recommendation_message : "request_id"
outfit_combo ||--o{ combo_candidate : "combo_id"
slot_candidate ||--o{ combo_candidate : "candidate_id"
}
package "notification_db" as notification_db {
  entity "notification_channel\n알림 채널 (미사용)" as notification_channel #EEEEEE {
    * channel_id : PK, VARCHAR, NOT NULL
  }
  entity "notification_log\n알림 로그" as notification_log {
    * log_id : PK, VARCHAR, NOT NULL
  }
}
package "community_db" as community_db {
  entity "community\n커뮤니티 게시글" as community {
    * post_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "vote_option\n투표 선택지" as vote_option {
    * vote_option_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "vote\n투표 기록" as vote {
    * vote_id : PK, VARCHAR, NOT NULL
  }
  entity "comment\n댓글" as comment {
    * comment_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "post_like\n게시글 좋아요" as post_like {
    * post_id : PK, FK, INT, NOT NULL
    * user_id : PK, FK(logical), INT, NOT NULL
  }
  entity "comment_like\n댓글 좋아요" as comment_like {
    * comment_id : PK, FK, INT, NOT NULL
    * user_id : PK, FK(logical), INT, NOT NULL
  }
community ||--o{ vote_option : "post_id"
community ||--o{ vote : "post_id"
vote_option ||--o{ vote : "vote_option_id"
community ||--o{ comment : "post_id"
comment |o--o{ comment : "parent_comment_id"
vote_option |o--o{ comment : "supported_option_id"
community ||--o{ post_like : "post_id"
comment ||--o{ comment_like : "comment_id"
}
package "ai_fitting_db" as ai_fitting_db {
  entity "ai_fitting\n가상피팅 작업" as ai_fitting {
    * fitting_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
}
package "survey_db" as survey_db {
  entity "size_survey\n사이즈 설문" as size_survey {
    * survey_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
}
user_db -[hidden]right- user_preferences_db
user_db -[hidden]down- order_db
user_preferences_db -[hidden]right- product_db
user_preferences_db -[hidden]down- review_db
product_db -[hidden]down- wishlist_db
order_db -[hidden]right- review_db
order_db -[hidden]down- cart_db
review_db -[hidden]right- wishlist_db
review_db -[hidden]down- recommendation_db
wishlist_db -[hidden]down- notification_db
cart_db -[hidden]right- recommendation_db
cart_db -[hidden]down- community_db
recommendation_db -[hidden]right- notification_db
recommendation_db -[hidden]down- ai_fitting_db
notification_db -[hidden]down- survey_db
community_db -[hidden]right- ai_fitting_db
ai_fitting_db -[hidden]right- survey_db
legend bottom left
  개요: PK와 도메인 내부 관계만 표시
  도메인 간 관계와 전체 컬럼: diagrams/<domain>.puml 참조
  모든 관계를 한 장에 표시: fitzza-erd.puml 참조
endlegend
@enduml
