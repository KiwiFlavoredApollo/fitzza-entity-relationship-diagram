@startuml ai_fitting_db
' Generated by scripts/generate_views.mjs; edit fitzza-erd.puml instead.
!pragma layout smetana
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 65
skinparam ranksep 85
skinparam entityBackgroundColor #F8FAFC
skinparam entityBorderColor #475569
hide circle
title Fitzza ERD — ai_fitting_db
package "ai_fitting_db" {
  entity "ai_fitting\n가상피팅 작업" as ai_fitting {
    ' Row 193: 피팅 작업 아이디 — IDM-VTON 작업 식별자
    * fitting_id : PK, INT, NOT NULL, AUTO_INCREMENT
    ' Row 194: 사용자 아이디
    * user_id : FK, INT, NOT NULL
    ' Row 195: 조합 아이디 — 누끼 이미지 매핑용
    * combo_id : FK, VARCHAR, NOT NULL
    ' Row 196: 결과 이미지 URL — 백엔드 완료 후 S3 저장
    result_image_url : VARCHAR(500), NULL
    ' Row 197: 작업 상태 — Redis 워커 상태 추적용
    job_status : ENUM('PENDING', 'PROCESSING', 'DONE', 'FAILED') DEFAULT 'PENDING'
    ' Row 198: 실패 사유
    error_message : TEXT, NULL
    ' Row 199: 요청일시
    * created_at : DATETIME, DEFAULT CURRENT_TIMESTAMP, NOT NULL
    ' Row 200: 완료일시
    * completed_at : DATETIME, NOT NULL
  }
}
package "외부 참조 (참조 키만 표시)" {
  entity "outfit_combo\n코디 조합\n[recommendation_db]" as outfit_combo #EEF2FF {
    * combo_id : PK, VARCHAR, NOT NULL
  }
  entity "users\n회원\n[user_db]" as users #EEF2FF {
    * user_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
}
users ||--o{ ai_fitting : "user_id"
outfit_combo ||--o{ ai_fitting : "combo_id"
legend bottom left
  * : NOT NULL explicitly stated in specification
  PK / FK / UNIQUE : source constraints; composite PK spans marked columns
  Solid line : FK stated in specification
  Dotted line : logical, inferred, or conditional reference
  Parent || : required reference; |o : nullable/conditional reference
  Child o{ : zero or more; o| : zero or one (shared primary key or UNIQUE FK)
  Gray entity : unused in source specification
  ENUM / VARCHAR without details and missing types are preserved as specified
endlegend

@enduml
