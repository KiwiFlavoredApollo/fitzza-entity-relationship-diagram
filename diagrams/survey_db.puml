@startuml survey_db
' Generated by scripts/generate_views.mjs; edit fitzza-erd.puml instead.
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 65
skinparam ranksep 85
skinparam entityBackgroundColor #F8FAFC
skinparam entityBorderColor #475569
hide circle
title Fitzza ERD — survey_db
package "survey_db" {
  entity "size_survey\n사이즈 설문" as size_survey {
    ' Row 201: 설문 아이디
    * survey_id : PK, INT, NOT NULL, AUTO_INCREMENT
    ' Row 202: 사용자 아이디 — user_db.users 참조
    * user_id : FK(logical), INT, NOT NULL
    ' Row 203: 옵션 아이디 — product_db.product_option 참조 — 사이즈별 평가라 필요
    * option_id : FK(logical), INT, NOT NULL
    ' Row 204: 주문 상품 아이디 — order_db.order_item 참조, 구매 검증용 — UNIQUE(user_id, order_item_id) 복합 유니크로 중복 설문 방지
    * order_item_id : FK(logical), INT, NOT NULL, UNIQUE
    ' Row 205: 사이즈 평가 — 작아요/잘맞아요/커요
    * size_feedback : ENUM('SMALL', 'FIT', 'BIG'), NOT NULL
    ' Row 206: 작성일
    * created_at : DATETIME, NOT NULL, DEFAULT CURRENT_TIMESTAMP
    --
    UNIQUE(user_id, order_item_id)
  }
}
package "외부 참조 (참조 키만 표시)" {
  entity "order_item\n주문 항목\n[order_db]" as order_item #EEF2FF {
    * order_item_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "product_option\n상품 옵션\n[product_db]" as product_option #EEF2FF {
    * option_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "users\n회원\n[user_db]" as users #EEF2FF {
    * user_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
}
users ||..o{ size_survey : "user_id [logical]"
product_option ||..o{ size_survey : "option_id [logical]"
order_item ||..o| size_survey : "order_item_id [logical]"
legend bottom left
  * : 명세서에 NOT NULL로 명시된 필수 컬럼
  PK / FK / UNIQUE : 기본 키 / 외래 키 / 유일성 제약
  복합 PK : PK로 표시된 여러 컬럼을 함께 기본 키로 사용
  실선 : 명세서에 명시된 외래 키 관계
  점선 : 논리적·추론된 참조 또는 유형에 따른 조건부 참조
  부모 쪽 || : 필수 참조, |o : NULL 허용 또는 조건부 참조
  자식 쪽 o{ : 0개 이상, o| : 0개 또는 1개 (공유 PK 또는 UNIQUE FK)
  회색 테이블 : 명세서에서 미사용으로 표시된 테이블
  연한 보라색 테이블 : 다른 도메인의 외부 참조 (참조 키만 표시)
  ENUM 값·VARCHAR 길이·자료형이 미정인 항목은 명세서 그대로 유지
endlegend

@enduml
