@startuml wishlist_db
' Generated by scripts/generate_views.mjs; edit fitzza-erd.puml instead.
!pragma layout smetana
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 65
skinparam ranksep 85
skinparam entityBackgroundColor #F8FAFC
skinparam entityBorderColor #475569
hide circle
title Fitzza ERD — wishlist_db
package "wishlist_db" {
  entity "wishlist\n찜한 상품" as wishlist {
    ' Row 77: 찜 아이디
    * wishlist_id : PK, INT, NOT NULL, AUTO_INCREMENT
    ' Row 78: 사용자 아이디 — UNIQUE(user_id, item_id, item_type) 복합 유니크 — 중복 챜하기 방지
    * user_id : FK, INT, NOT NULL
    ' Row 79: 상품/코디 아이디 — PRODUCT일 땐 product_id(INT), COMBO일 땐 combo_id(VARCHAR/UUID) 참조 — 폴리모픽 FK라 컬럼 타입을 VARCHAR로 통일 (기존 INT로는 COMBO의 UUID 저장 불가)
    * item_id : FK, VARCHAR, NOT NULL
    ' Row 80: 아이템 타입 — item_id가 product인지 outfit_combo인지 구분
    * item_type : ENUM('PRODUCT', 'COMBO'), NOT NULL
    ' Row 81: 찜한 날짜
    * created_at : DEFAULT CURRENT_TIMESTAMP, NOT NULL
    --
    UNIQUE(user_id, item_id, item_type)
  }
  entity "worldcup_history\n월드컵 우승 이력" as worldcup_history {
    ' Row 82: 월드컵 이력 아이디 — 월드컵을 완료할 때마다 새 이력 저장
    * worldcup_history_id : PK, INT, NOT NULL, AUTO_INCREMENT
    ' Row 83: 사용자 아이디 — user_db.users 참조
    * user_id : FK(logical), INT, NOT NULL
    ' Row 84: 우승 상품 아이디 — product_db.product(product_id) 참조. 과거 기록 보존을 위해 상품 물리 삭제 제한
    * winner_product_id : FK(logical), INT, NOT NULL
    ' Row 85: 완료 시각 — 최근 우승 결과 조회에 사용
    * completed_at : DATETIME, NOT NULL, DEFAULT CURRENT_TIMESTAMP
  }
}
package "외부 참조 (참조 키만 표시)" {
  entity "outfit_combo\n코디 조합\n[recommendation_db]" as outfit_combo #EEF2FF {
    * combo_id : PK, VARCHAR, NOT NULL
  }
  entity "product\n상품\n[product_db]" as product #EEF2FF {
    * product_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "users\n회원\n[user_db]" as users #EEF2FF {
    * user_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
}
users ||--o{ wishlist : "user_id"
users ||..o{ worldcup_history : "user_id [logical]"
product ||..o{ worldcup_history : "winner_product_id [logical]"
product |o..o{ wishlist : "item_id [PRODUCT]"
outfit_combo |o..o{ wishlist : "item_id [COMBO]"
legend bottom left
  * : NOT NULL explicitly stated in specification
  PK / FK / UNIQUE : source constraints; composite PK spans marked columns
  Solid line : FK stated in specification
  Dotted line : logical, inferred, or conditional reference
  Parent || : required reference; |o : nullable/conditional reference
  Child o{ : zero or more; o| : zero or one (shared primary key or UNIQUE FK)
  Gray entity : unused in source specification
  ENUM / VARCHAR without details and missing types are preserved as specified
endlegend

@enduml
