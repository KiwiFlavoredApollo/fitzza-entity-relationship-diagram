@startuml product_db
' Generated by scripts/generate_views.mjs; edit fitzza-erd.puml instead.
!pragma layout smetana
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 65
skinparam ranksep 85
skinparam entityBackgroundColor #F8FAFC
skinparam entityBorderColor #475569
hide circle
title Fitzza ERD — product_db
package "product_db" {
  entity "brand\n브랜드" as brand {
    ' Row 29: 브랜드 아이디
    * brand_id : PK, INT, NOT NULL, AUTO_INCREMENT
    ' Row 30: 브랜드명
    * brand_name : VARCHAR(100), NOT NULL, UNIQUE
  }
  entity "product\n상품" as product {
    ' Row 31: 상품 아이디
    * product_id : PK, INT, NOT NULL, AUTO_INCREMENT
    ' Row 32: 브랜드 아이디 — brand 참조
    * brand_id : FK, INT, NOT NULL
    ' Row 33: 상품명
    * product_name : VARCHAR(255), NOT NULL
    ' Row 34: 카테고리 — 기존 category 유지(하위 호환) 또는 제거 협의 필요
    * category : VARCHAR(100), NOT NULL
    ' Row 35: 대분류 카테고리 — 예: 상의 — 기존 'category' 하나로는 계층형 카테고리 탐색(상의>긴팔>셔츠) 구현 불가
    * category_1 : VARCHAR, NOT NULL
    ' Row 36: 중분류 카테고리 — 예: 긴팔
    * category_2 : VARCHAR, NOT NULL
    ' Row 37: 소분류 카테고리 — 예: 셔츠
    * subcategory : VARCHAR, NOT NULL
    ' Row 38: 기본 가격
    * price : INT, NOT NULL
    ' Row 39: 소재
    material : VARCHAR(100)
    ' Row 40: 계절 — NULL
    season : ENUM("SS", "FW", "ALL")
    ' Row 41: 핏 — NULL
    fit_type : ENUM("REGULAR", "RELAXED", "CROPPED", "SLIM", "OVERSIZED")
    ' Row 42: 상품 설명
    description : TEXT
    ' Row 43: 대표 이미지 URL
    image_url : VARCHAR(500)
    ' Row 44: 판매 상태
    status : ENUM('ON_SALE', 'SOLD_OUT', 'HIDDEN') DEFAULT 'ON_SALE'
    ' Row 45: 등록일
    * created_at : DEFAULT CURRENT_TIMESTAMP, NOT NULL
    ' Row 46: 수정일
    updated_at : DATETIME, DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
  }
  entity "product_option\n상품 옵션" as product_option {
    ' Row 47: 옵션 아이디
    * option_id : PK, INT, NOT NULL, AUTO_INCREMENT
    ' Row 48: 상품 아이디
    * product_id : FK, INT, NOT NULL
    ' Row 49: 색상
    color : VARCHAR(50)
    ' Row 50: 사이즈
    size : VARCHAR(50)
  }
  entity "product_measurement\n상품 실측" as product_measurement {
    ' Row 51: 옵션 아이디 — product_option 참조 — 사이즈별로 실측값이 다르므로 product_id가 아닌 option_id 기준으로 변경
    * option_id : PK, FK, INT, NOT NULL
    ' Row 52: 실측
    measurement_spec : JSON
  }
}
brand ||--o{ product : "brand_id"
product ||--o{ product_option : "product_id"
product_option ||--o| product_measurement : "option_id"
legend bottom left
  * : NOT NULL explicitly stated in specification
  PK / FK / UNIQUE : source constraints; composite PK spans marked columns
  Solid line : FK stated in specification
  Dotted line : logical, inferred, or conditional reference
  Parent || : required reference; |o : nullable/conditional reference
  Child o{ : zero or more; o| : zero or one (shared primary key or UNIQUE FK)
  Gray entity : unused in source specification
  ENUM / VARCHAR without details and missing types are preserved as specified
endlegend

@enduml
