  }
relation_19_parent ||-right-o{ relation_19_child
}
package "관계 20 · product_id [logical]" as relation_20 {
  entity "product\n상품\n[product_db]" as relation_20_parent #EEF2FF {
    * product_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "slot_candidate\n슬롯 후보\n[recommendation_db]" as relation_20_child {
    * candidate_id : PK, VARCHAR, NOT NULL
    * product_id : FK(logical), INT, NOT NULL
  }
relation_20_parent ||.right.o{ relation_20_child
}
package "관계 21 · request_id" as relation_21 {
  entity "recommendation_request\n추천 요청\n[recommendation_db]" as relation_21_parent #EEF2FF {
    * request_id : PK, VARCHAR, NOT NULL
  }
  entity "outfit_combo\n코디 조합\n[recommendation_db]" as relation_21_child {
    * combo_id : PK, VARCHAR, NOT NULL
    * request_id : FK, VARCHAR, NOT NULL
  }
relation_21_parent ||-right-o{ relation_21_child
}
package "관계 22 · request_id" as relation_22 {
  entity "recommendation_request\n추천 요청\n[recommendation_db]" as relation_22_parent #EEF2FF {
    * request_id : PK, VARCHAR, NOT NULL
  }
  entity "recommendation_message\n추천 대화 히스토리\n[recommendation_db]" as relation_22_child {
    * message_id : PK, VARCHAR, NOT NULL
    * request_id : FK, VARCHAR (recommendation_request 참조), NOT NULL
  }
relation_22_parent ||-right-o{ relation_22_child
}
package "관계 23 · combo_id" as relation_23 {
  entity "outfit_combo\n코디 조합\n[recommendation_db]" as relation_23_parent #EEF2FF {
