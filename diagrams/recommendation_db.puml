  entity "users\n회원\n[user_db]" as relation_17_parent #EEF2FF {
    * user_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "recommendation_request\n추천 요청\n[recommendation_db]" as relation_17_child {
    * request_id : PK, VARCHAR, NOT NULL
    user_id : FK(logical), INT, NULL
  }
relation_17_parent |o.right.o{ relation_17_child
}
