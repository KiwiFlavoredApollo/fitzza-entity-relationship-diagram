@startuml order_db
' Generated by scripts/generate_views.mjs; edit fitzza-erd.puml instead.
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 65
skinparam ranksep 85
skinparam entityBackgroundColor #F8FAFC
skinparam entityBorderColor #475569
hide circle
title Fitzza ERD — order_db
package "order_db" {
  entity "orders\n주문" as orders {
    ' Row 53: 주문 아이디
    * order_id : PK, INT, NOT NULL, AUTO_INCREMENT
    ' Row 54: 주문 번호
    * order_num : UNIQUE, VARCHAR(100), NOT NULL
    ' Row 55: 사용자 아이디
    * user_id : FK, INT, NOT NULL
    ' Row 56: 총 주문 금액
    * total_price : INT, NOT NULL
    ' Row 57: 주문 상태
    order_status : ENUM('PENDING', 'PAID', 'SHIPPING', 'COMPLETED', 'CANCELED') DEFAULT 'PENDING'
    ' Row 58: 주문일
    * created_at : DEFAULT CURRENT_TIMESTAMP, NOT NULL
    ' Row 59: 수정일
    updated_at : DATETIME, DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
    ' Row 60: 수령인명 — 배송지 수령인
    * recipient_name : VARCHAR(50), NOT NULL
    ' Row 61: 수령인 연락처 — 배송지 연락처
    * recipient_phone : VARCHAR(20), NOT NULL
    ' Row 62: 배송지 주소 — 상세주소 포함
    * shipping_address : VARCHAR(255), NOT NULL
  }
  entity "order_item\n주문 항목" as order_item {
    ' Row 63: 주문항목 아이디
    * order_item_id : PK, INT, NOT NULL, AUTO_INCREMENT
    ' Row 64: 주문 아이디
    * order_id : FK, INT, NOT NULL
    ' Row 65: 옵션 아이디
    * option_id : FK, INT, NOT NULL
    ' Row 66: 주문 수량
    * order_qty : INT, NOT NULL
    ' Row 67: 구매 단가
    * unit_price : INT, NOT NULL
  }
}
package "외부 참조 (참조 키만 표시)" {
  entity "product_option\n상품 옵션\n[product_db]" as product_option #EEF2FF {
    * option_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
  entity "users\n회원\n[user_db]" as users #EEF2FF {
    * user_id : PK, INT, NOT NULL, AUTO_INCREMENT
  }
}
users ||--o{ orders : "user_id"
orders ||--o{ order_item : "order_id"
product_option ||--o{ order_item : "option_id"
legend bottom left
  * : 명세서에 NOT NULL로 명시된 필수 컬럼
  PK / FK / UNIQUE : 기본 키 / 외래 키 / 유일성 제약
  복합 PK : PK로 표시된 여러 컬럼을 함께 기본 키로 사용
  실선 : 명세서에 명시된 외래 키 관계
  점선 : 논리적·추론된 참조 또는 유형에 따른 조건부 참조
  부모 쪽 || : 필수 참조, |o : NULL 허용 또는 조건부 참조
  자식 쪽 o{ : 0개 이상, o| : 0개 또는 1개 (공유 PK 또는 UNIQUE FK)
  회색 테이블 : 명세서에서 미사용으로 표시된 테이블
  연한 보라색 테이블 : 다른 도메인의 외부 참조 (참조 키만 표시)
  ENUM 값·VARCHAR 길이·자료형이 미정인 항목은 명세서 그대로 유지
endlegend

@enduml
